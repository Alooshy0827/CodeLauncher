#!/bin/bash
# @label Java
# 一键新建 Java 项目 —— 用法: new-java 项目名
set -e

NAME="$1"
if [ -z "$NAME" ]; then
    echo "用法: new-java 项目名"
    echo "例如: new-java 我的程序"
    exit 1
fi

ROOT="$HOME/VS Code"
DIR="$ROOT/$NAME"

if [ -e "$DIR" ]; then
    echo "❌ 项目 '$NAME' 已存在: $DIR"
    exit 1
fi

# ── 检测 JDK ──
# 注意：macOS 上没装 JDK 时 /usr/bin/javac 也存在，但那只是个占位存根
# （执行只会提示 "Unable to locate a Java Runtime"），所以必须真的跑一次看输出。
JAVAC=""
if command -v javac >/dev/null 2>&1 && javac -version 2>&1 | grep -q '^javac '; then
    JAVAC="$(command -v javac)"
fi
JAVA=""
if command -v java >/dev/null 2>&1 && java -version 2>&1 | grep -qE '^(java|openjdk) version'; then
    JAVA="$(command -v java)"
fi

# ── 目录结构 ──
mkdir -p "$DIR/src" "$DIR/bin" "$DIR/.vscode"

# ── src/Main.java ──
cat > "$DIR/src/Main.java" <<'EOF'
public class Main {
    public static void main(String[] args) {
        System.out.println("Hello, Java!");
    }
}
EOF

# ── .vscode/settings.json（给 Java 扩展用）──
cat > "$DIR/.vscode/settings.json" <<'EOF'
{
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "bin",
    "java.configuration.updateBuildConfiguration": "automatic"
}
EOF

# ── .vscode/tasks.json（不依赖任何扩展，javac + java 直接可用）──
cat > "$DIR/.vscode/tasks.json" <<'EOF'
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding", "UTF-8",
                "-d", "${workspaceFolder}/bin",
                "${workspaceFolder}/src/Main.java"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$javac"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Cmd+Shift+B：编译 src/Main.java"
        },
        {
            "label": "运行",
            "type": "shell",
            "command": "java",
            "args": ["-cp", "${workspaceFolder}/bin", "Main"],
            "dependsOn": "编译",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "先编译再运行"
        }
    ]
}
EOF

# ── .vscode/launch.json（配合 Extension Pack for Java）──
cat > "$DIR/.vscode/launch.json" <<EOF
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "调试 (F5)",
            "request": "launch",
            "mainClass": "Main",
            "projectName": "$NAME",
            "cwd": "\${workspaceFolder}"
        }
    ]
}
EOF

# ── 工具链缺失时的项目内强提示 ──
if [ -z "$JAVAC" ]; then
    cat > "$DIR/!缺少工具链.md" <<'EOF'
# ⚠️ 这个项目现在还编译不了

缺少 **JDK**（找不到 `javac`）。

注意：光有 `java` 不够，编译需要 JDK（Java Development Kit），不是 JRE。

## 怎么装（任选其一）

**方式一：Homebrew**

```bash
brew install openjdk
```

装完后按 Homebrew 的提示，把 JDK 注册到系统：

```bash
sudo ln -sfn $(brew --prefix)/opt/openjdk/libexec/openjdk.jdk \
  /Library/Java/JavaVirtualMachines/openjdk.jdk
```

**方式二：Adoptium（图形化安装，适合新手）**

到 https://adoptium.net 下载 macOS 的 `.pkg` 安装包，双击一路下一步。

**方式三：Oracle JDK**

到 https://www.oracle.com/java/technologies/downloads/ 下载。

## 装完之后

1. 重开一个终端，运行 `javac -version` 确认能输出版本号
2. **删掉本文件**
3. 回到 VS Code，按 `Cmd+Shift+B` 编译

## 建议

顺手装上 VS Code 扩展 **Extension Pack for Java**，
装好后 `Main.java` 里 `main` 上方会出现 Run / Debug 按钮，`F5` 也能直接调试。

> 项目本身不用重建 —— JDK 装好，这个项目直接就能用。
EOF
fi

# ── 汇报 ──
echo "✅ 项目创建成功: $DIR"
echo ""
echo "结构:"
echo "  $NAME/"
echo "  ├── src/Main.java   ← 在这里写代码"
echo "  ├── .vscode/        ← 配置（已配好，不用管）"
echo "  └── bin/            ← 编译产物"
echo ""
if [ -n "$JAVAC" ]; then
    echo "JDK: $JAVAC"
    echo "      $("$JAVAC" -version 2>&1 | head -1)"
else
    echo "⚠️  没有检测到 JDK！"
    echo "   已在项目里生成 !缺少工具链.md，打开它看安装方法。"
fi
echo ""
echo "下一步:"
echo "  code \"$DIR\"          用 VS Code 打开"
echo "  然后按 Cmd+Shift+B 编译，F5 调试运行"

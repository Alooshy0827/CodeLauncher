#!/bin/bash
# @label Python
# 一键新建 Python 项目 —— 用法: new-py 项目名
set -e

NAME="$1"
if [ -z "$NAME" ]; then
    echo "用法: new-py 项目名"
    echo "例如: new-py 我的脚本"
    exit 1
fi

ROOT="$HOME/VS Code"
DIR="$ROOT/$NAME"

if [ -e "$DIR" ]; then
    echo "❌ 项目 '$NAME' 已存在: $DIR"
    exit 1
fi

mkdir -p "$DIR/.vscode"

# ── 检测 Python ──
# 注意：macOS 上的 /usr/bin/python3 可能只是占位存根，必须真的跑一次看输出
PY=""
for p in python3 python; do
    if command -v "$p" >/dev/null 2>&1 && "$p" --version 2>&1 | grep -q '^Python '; then
        PY="$(command -v "$p")"
        break
    fi
done

# ── 创建虚拟环境 ──
VENV_OK=0
if [ -n "$PY" ]; then
    echo "正在创建虚拟环境（几秒钟）..."
    if "$PY" -m venv "$DIR/.venv" 2>/dev/null && [ -x "$DIR/.venv/bin/python" ]; then
        echo "  ✅ 虚拟环境已建好"
        VENV_OK=1
    else
        echo "  ⚠️  虚拟环境创建失败"
    fi
fi

# ── main.py ──
cat > "$DIR/main.py" <<'EOF'
def main():
    print("你好，Python！")


if __name__ == "__main__":
    main()
EOF

# ── .vscode/settings.json（指定解释器 + 自动激活 venv）──
cat > "$DIR/.vscode/settings.json" <<'EOF'
{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true
}
EOF

# ── 工具链缺失时的项目内强提示 ──
if [ "$VENV_OK" -eq 0 ]; then
    cat > "$DIR/!缺少工具链.md" <<'EOF'
# ⚠️ 这个项目现在跑不起来

缺少 **Python 3**（找不到 `python3`），所以虚拟环境没能创建。

## 怎么装（任选其一）

**方式一：Homebrew（推荐）**

```bash
brew install python
```

**方式二：官网安装包**

到 https://www.python.org/downloads/ 下载 macOS 安装包，双击安装。

## 装完之后

在项目目录里手动补上虚拟环境：

```bash
cd "本项目所在目录"
python3 -m venv .venv
```

然后：

1. **删掉本文件**
2. 回到 VS Code，按 `F5` 运行，或在终端里执行 `python main.py`

> 也可以直接删掉本文件，只把 `python3` 装好 —— 项目结构本身是完整的，
> 只是少了 `.venv` 那一层虚拟环境。
EOF
fi

echo ""
echo "✅ 项目创建成功: $DIR"
echo ""
echo "结构:"
echo "  $NAME/"
echo "  ├── main.py         ← 在这里写代码"
if [ "$VENV_OK" -eq 1 ]; then
    echo "  ├── .venv/          ← Python 虚拟环境（已建好）"
else
    echo "  ├── .venv/          ← ⚠️ 未创建（缺 Python）"
fi
echo "  └── .vscode/        ← 配置"
echo ""
if [ -n "$PY" ]; then
    echo "Python: $PY"
    echo "        $("$PY" --version 2>&1)"
else
    echo "⚠️  没有检测到 Python！"
    echo "   已在项目里生成 !缺少工具链.md，打开它看安装方法。"
fi
echo ""
echo "下一步:"
echo "  code \"$DIR\"          用 VS Code 打开"
echo "  然后按 F5 运行，或者终端里 python main.py"

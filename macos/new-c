#!/bin/bash
# @label C
# 一键新建 C 项目 —— 用法: new-c 项目名
set -e

NAME="$1"
if [ -z "$NAME" ]; then
    echo "用法: new-c 项目名"
    echo "例如: new-c 我的程序"
    exit 1
fi

ROOT="$HOME/VS Code"
DIR="$ROOT/$NAME"

if [ -e "$DIR" ]; then
    echo "❌ 项目 '$NAME' 已存在: $DIR"
    exit 1
fi

# ── 检测编译器 ──
# 注意：macOS 上有些命令可能只是占位存根，必须真的执行一次确认能输出版本号
CC=""
for c in cc clang gcc; do
    if command -v "$c" >/dev/null 2>&1 && "$c" --version >/dev/null 2>&1; then
        CC="$(command -v "$c")"
        break
    fi
done

# 目录结构
mkdir -p "$DIR/src" "$DIR/build" "$DIR/.vscode"

# ── c_cpp_properties.json ──
cat > "$DIR/.vscode/c_cpp_properties.json" <<'EOF'
{
    "version": 4,
    "configurations": [
        {
            "name": "Mac-C",
            "includePath": [
                "${workspaceFolder}/src/**",
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "intelliSenseMode": "macos-clang-arm64",
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ]
        }
    ]
}
EOF

# ── tasks.json ──
cat > "$DIR/.vscode/tasks.json" <<'EOF'
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "/usr/bin/cc",
            "args": [
                "-std=c17", "-Wall", "-Wextra", "-g", "-O0",
                "-o", "${workspaceFolder}/build/main",
                "${workspaceFolder}/src/main.c"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Cmd+Shift+B：编译 src/main.c"
        },
        {
            "label": "运行",
            "type": "shell",
            "command": "${workspaceFolder}/build/main",
            "dependsOn": "编译",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "先编译再运行"
        }
    ]
}
EOF

# ── launch.json ──
cat > "$DIR/.vscode/launch.json" <<'EOF'
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
            "MIMode": "lldb",
            "miDebuggerPath": "${userHome}/.vscode/extensions/ms-vscode.cpptools-1.34.4-darwin-arm64/debugAdapters/lldb-mi/bin/lldb-mi",
            "preLaunchTask": "编译",
            "setupCommands": [
                {
                    "description": "启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
EOF

# ── src/main.c（空骨架）──
cat > "$DIR/src/main.c" <<'EOF'
#include <stdio.h>

int main(void)
{

    return 0;
}
EOF

# ── 工具链缺失时的项目内强提示 ──
if [ -z "$CC" ]; then
    cat > "$DIR/!缺少工具链.md" <<'EOF'
# ⚠️ 这个项目现在还编译不了

缺少 **C 编译器**（`cc`、`clang`、`gcc` 都没找到）。

## 怎么装

打开「终端」，运行：

```bash
xcode-select --install
```

会弹出一个安装窗口，点「安装」等它跑完即可。
这一步同时会装好 `clang`、`make`、`git` 等基础工具。

## 装完之后

1. 重开一个终端，运行 `cc --version` 确认能输出版本号
2. **删掉本文件**
3. 回到 VS Code，按 `Cmd+Shift+B` 编译，`F5` 调试

> 项目本身不用重建 —— 编译器装好，这个项目直接就能用。
EOF
fi

echo "✅ 项目创建成功: $DIR"
echo ""
echo "结构:"
echo "  $NAME/"
echo "  ├── src/main.c      ← 在这里写代码"
echo "  ├── .vscode/        ← 配置（已配好，不用管）"
echo "  └── build/          ← 编译产物"
echo ""
if [ -n "$CC" ]; then
    echo "编译器: $CC"
else
    echo "⚠️  没有检测到 C 编译器！"
    echo "   已在项目里生成 !缺少工具链.md，打开它看安装方法。"
fi
echo ""
echo "下一步:"
echo "  code \"$DIR\"          用 VS Code 打开"
echo "  然后按 Cmd+Shift+B 编译，F5 调试运行"

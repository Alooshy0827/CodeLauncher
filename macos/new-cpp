#!/bin/bash
# @label C++
# 一键新建 C++ 项目 —— 用法: new-cpp 项目名
set -e

NAME="$1"
if [ -z "$NAME" ]; then
    echo "用法: new-cpp 项目名"
    echo "例如: new-cpp 我的程序"
    exit 1
fi

ROOT="$HOME/VS Code"
DIR="$ROOT/$NAME"

if [ -e "$DIR" ]; then
    echo "❌ 项目 '$NAME' 已存在: $DIR"
    exit 1
fi

# ── 检测编译器 ──
CXX=""
for c in g++ clang++; do
    if command -v "$c" >/dev/null 2>&1 && "$c" --version >/dev/null 2>&1; then
        CXX="$(command -v "$c")"
        break
    fi
done

# ── 定位 C/C++ 扩展自带的 lldb-mi（不写死版本号）──
LLDB_MI="$(ls -d "$HOME"/.vscode/extensions/ms-vscode.cpptools-*/debugAdapters/lldb-mi/bin/lldb-mi 2>/dev/null | tail -1 || true)"

# ── 目录结构 ──
mkdir -p "$DIR/src" "$DIR/build" "$DIR/.vscode"

# ── c_cpp_properties.json ──
cat > "$DIR/.vscode/c_cpp_properties.json" <<EOF
{
    "version": 4,
    "configurations": [
        {
            "name": "Mac-C++",
            "includePath": [
                "\${workspaceFolder}/src/**"
            ],
            "defines": [],
            "compilerPath": "${CXX:-/usr/bin/clang++}",
            "cppStandard": "c++17",
            "cStandard": "c17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ]
}
EOF

# ── tasks.json ──
cat > "$DIR/.vscode/tasks.json" <<EOF
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "${CXX:-clang++}",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-g", "-O0",
                "-o", "\${workspaceFolder}/build/main",
                "\${workspaceFolder}/src/main.cpp"
            ],
            "options": { "cwd": "\${workspaceFolder}" },
            "problemMatcher": ["\$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Cmd+Shift+B：编译 src/main.cpp"
        },
        {
            "label": "运行",
            "type": "shell",
            "command": "\${workspaceFolder}/build/main",
            "dependsOn": "编译",
            "options": { "cwd": "\${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "先编译再运行"
        }
    ]
}
EOF

# ── launch.json（找不到 lldb-mi 时不写该字段，交给扩展自己找）──
if [ -n "$LLDB_MI" ]; then
    DEBUGGER_LINE="            \"miDebuggerPath\": \"$LLDB_MI\","
else
    DEBUGGER_LINE=""
fi

cat > "$DIR/.vscode/launch.json" <<EOF
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "\${workspaceFolder}/build/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "\${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
            "MIMode": "lldb",
$DEBUGGER_LINE
            "preLaunchTask": "编译",
            "setupCommands": [
                {
                    "description": "启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
EOF

# ── src/main.cpp ──
cat > "$DIR/src/main.cpp" <<'EOF'
#include <iostream>

int main()
{
    std::cout << "Hello, C++!" << std::endl;
    return 0;
}
EOF

# ── 工具链缺失时的项目内强提示 ──
if [ -z "$CXX" ]; then
    cat > "$DIR/!缺少工具链.md" <<'EOF'
# ⚠️ 这个项目现在还编译不了

缺少 **C++ 编译器**（既没有 `g++` 也没有 `clang++`）。

## 怎么装（任选其一）

**方式一：Xcode Command Line Tools（推荐，最省事）**

打开「终端」，运行：

```bash
xcode-select --install
```

会弹出一个安装窗口，点「安装」等它跑完即可。

**方式二：用 Homebrew 装 GCC**

```bash
brew install gcc
```

## 装完之后

1. 重开一个终端，运行 `g++ --version` 确认能输出版本号
2. **删掉本文件**
3. 回到 VS Code，按 `Cmd+Shift+B` 编译，`F5` 调试

> 项目本身不用重建 —— 编译器装好，这个项目直接就能用。
EOF
fi

# ── 汇报 ──
echo "✅ 项目创建成功: $DIR"
echo ""
echo "结构:"
echo "  $NAME/"
echo "  ├── src/main.cpp    ← 在这里写代码"
echo "  ├── .vscode/        ← 配置（已配好，不用管）"
echo "  └── build/          ← 编译产物"
echo ""
if [ -n "$CXX" ]; then
    echo "编译器: $CXX"
else
    echo "⚠️  没有检测到 C++ 编译器！"
    echo "   已在项目里生成 !缺少工具链.md，打开它看安装方法。"
fi
echo ""
echo "下一步:"
echo "  code \"$DIR\"          用 VS Code 打开"
echo "  然后按 Cmd+Shift+B 编译，F5 调试运行"
